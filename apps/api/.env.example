# Server
PORT=4000
NODE_ENV=development
ENABLE_SWAGGER=true
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:3002

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/findfunlinks_dev?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT Secrets
JWT_ACCESS_SECRET=super_secret_access_key_min_32_characters_random
JWT_REFRESH_SECRET=super_secret_refresh_key_min_32_characters_random
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Email / Mailpit
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM="FindFunLinks <noreply@findfunlinks.com>"
ALLOW_TEMP_PASSWORD_EMAIL=false

# Super Admin Seed
SUPER_ADMIN_EMAIL=admin@findfunlinks.com
SUPER_ADMIN_PASSWORD=SuperAdminSecretPass123!

