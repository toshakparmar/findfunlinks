# Server
PORT=4000
NODE_ENV=development
ENABLE_SWAGGER=true
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Supabase PostgreSQL Database (IPv4 Pooler & Direct Session Mode)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-1-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-1-ap-northeast-1.pooler.supabase.com:5432/postgres"

# Supabase Storage Configuration
SUPABASE_URL="https://[PROJECT-REF].supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_STORAGE_BUCKET="finallinks-media"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT Secrets
JWT_ACCESS_SECRET=super_secret_access_key_min_32_characters_random
JWT_REFRESH_SECRET=super_secret_refresh_key_min_32_characters_random
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Email / Mailpit
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM="FinalLinks <noreply@finallinks.com>"
ALLOW_TEMP_PASSWORD_EMAIL=false

# Super Admin Seed
SUPER_ADMIN_EMAIL=admin@finallinks.com
SUPER_ADMIN_PASSWORD=SuperAdminSecretPass123!
