datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum RoleType {
  SUPER_ADMIN
  WEBSITE_OWNER
  CUSTOM
}

enum RegistrationStatus {
  PENDING
  CHANGES_REQUESTED
  APPROVED
  REJECTED
}

enum WebsiteStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum ContentRating {
  ALL
  MATURE
}

enum DomainType {
  PRIMARY
  MIRROR
  PROXY
  ALTERNATE
}

enum DomainStatus {
  ACTIVE
  DOWN
  PENDING
  BLOCKED
}

enum ReportStatus {
  PENDING
  RESOLVED
  DISMISSED
}

enum TokenType {
  INVITE
  PASSWORD_RESET
}

// -----------------------------------------------------------------------------
// Authentication and RBAC
// -----------------------------------------------------------------------------

model User {
  id                 String               @id @default(uuid())
  email              String               @unique
  passwordHash       String
  name               String
  avatarUrl          String?
  status             UserStatus           @default(INVITED)
  mustChangePassword Boolean              @default(false)
  twoFactorSecret    String?
  twoFactorEnabled   Boolean              @default(false)
  lastLoginAt        DateTime?
  failedLoginCount   Int                  @default(0)
  lockedUntil        DateTime?
  roleId             String
  role               Role                 @relation(fields: [roleId], references: [id])
  website            Website?             // 1-to-1: One owner = exactly one website
  refreshTokens      RefreshToken[]
  tokens             Token[]
  auditLogs          AuditLog[]
  handledReports     Report[]             @relation("ReportHandler")
  reviewedRequests   RegistrationRequest[] @relation("RequestReviewer")
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  deletedAt          DateTime?

  @@index([email])
  @@index([roleId])
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  isSystem    Boolean          @default(false)
  type        RoleType         @default(CUSTOM)
  permissions RolePermission[]
  users       User[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Permission {
  id          String           @id @default(uuid())
  key         String           @unique // e.g. "website.approve"
  module      String           // e.g. "website"
  description String?
  roles       RolePermission[]
  createdAt   DateTime         @default(now())
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model RefreshToken {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash    String
  userAgent    String?
  ip           String?
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  createdAt    DateTime  @default(now())

  @@index([userId])
  @@index([tokenHash])
}

model Token {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  type      TokenType
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([tokenHash])
}

// -----------------------------------------------------------------------------
// Directory Entities
// -----------------------------------------------------------------------------

model Category {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  description String?
  icon        String?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  websites    Website[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([slug])
  @@index([sortOrder])
}

model Tag {
  id        String       @id @default(uuid())
  name      String
  slug      String       @unique
  websites  WebsiteTag[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([slug])
}

model RegistrationRequest {
  id                 String             @id @default(uuid())
  referenceId        String?            @unique
  applicantName      String
  applicantEmail     String
  applicantPhone     String?
  applicantRole      String             @default("OWNER")
  applicantCountry   String             @default("Global")
  telegramOrDiscord  String?
  websiteName        String
  primaryUrl         String
  additionalDomains  String[]           @default([])
  description        String
  categoryId         String
  proposedTags       String[]           @default([])
  logoUrl            String?
  language           String             @default("en")
  contentRating      ContentRating      @default(ALL)
  verificationMethod String             @default("DNS_TXT")
  verificationToken  String?
  verificationProof  String?
  adminNote          String?
  status             RegistrationStatus @default(PENDING)
  reviewerId         String?
  reviewer           User?              @relation("RequestReviewer", fields: [reviewerId], references: [id])
  reviewNote         String?
  reviewedAt         DateTime?
  ip                 String?
  userAgent          String?
  captchaScore       Float?
  resultingUserId    String?
  resultingWebsiteId String?
  submittedAt        DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([status])
  @@index([applicantEmail])
  @@index([primaryUrl])
  @@index([referenceId])
}

model Website {
  id             String        @id @default(uuid())
  ownerId        String        @unique // Exactly one website per owner
  owner          User          @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  name           String
  slug           String        @unique
  tagline        String?
  description    String
  logoUrl        String?
  coverUrl       String?
  categoryId     String
  category       Category      @relation(fields: [categoryId], references: [id])
  tags           WebsiteTag[]
  language       String        @default("en")
  contentRating  ContentRating @default(ALL)
  status         WebsiteStatus @default(PENDING_REVIEW)
  isFeatured     Boolean       @default(false)
  seoTitle       String?
  seoDescription String?
  socialLinks    Json?
  viewCount      Int           @default(0)
  domains        Domain[]
  reports        Report[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?

  @@index([slug])
  @@index([categoryId])
  @@index([status])
  @@index([isFeatured])
}

model WebsiteTag {
  websiteId String
  tagId     String
  website   Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([websiteId, tagId])
}

model Domain {
  id                  String        @id @default(uuid())
  websiteId           String
  website             Website       @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  hostname            String        @unique // Globally unique hostname
  url                 String
  label               String?
  type                DomainType    @default(PRIMARY)
  status              DomainStatus  @default(ACTIVE)
  sortOrder           Int           @default(0)
  lastCheckedAt       DateTime?
  lastResponseMs      Int?
  lastStatusCode      Int?
  consecutiveFailures Int           @default(0)
  isPublic            Boolean       @default(true)
  clickCount          Int           @default(0)
  addedById           String?
  checks              DomainCheck[]
  reports             Report[]
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@index([websiteId])
  @@index([hostname])
  @@index([status])
  @@index([isPublic])
}

model DomainCheck {
  id         String   @id @default(uuid())
  domainId   String
  domain     Domain   @relation(fields: [domainId], references: [id], onDelete: Cascade)
  status     String
  responseMs Int?
  statusCode Int?
  checkedAt  DateTime @default(now())

  @@index([domainId])
  @@index([checkedAt])
}

// -----------------------------------------------------------------------------
// Operations, CMS, and Audit
// -----------------------------------------------------------------------------

model Report {
  id            String       @id @default(uuid())
  websiteId     String?
  website       Website?     @relation(fields: [websiteId], references: [id], onDelete: SetNull)
  domainId      String?
  domain        Domain?      @relation(fields: [domainId], references: [id], onDelete: SetNull)
  reason        String
  details       String
  reporterEmail String?
  status        ReportStatus @default(PENDING)
  handledById   String?
  handledBy     User?        @relation("ReportHandler", fields: [handledById], references: [id])
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([status])
  @@index([websiteId])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String   // e.g. "website.approve", "domain.block"
  entityType String   // e.g. "Website", "Domain"
  entityId   String
  before     Json?
  after      Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model Page {
  id        String   @id @default(uuid())
  slug      String   @unique
  title     String
  content   String
  updatedAt DateTime @updatedAt

  @@index([slug])
}

model EmailLog {
  id         String   @id @default(uuid())
  to         String
  template   String
  status     String   // "SENT" | "FAILED"
  providerId String?
  error      String?
  createdAt  DateTime @default(now())

  @@index([to])
  @@index([createdAt])
}


