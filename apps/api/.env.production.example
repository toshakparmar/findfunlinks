# ==============================================================================
# FinalLinks NestJS Backend - Production Environment Variables
# Copy these values into Render.com dashboard -> Web Service -> Environment
# ==============================================================================

# Core Service Configuration
NODE_ENV=production
PORT=10000
ENABLE_SWAGGER=true

# ------------------------------------------------------------------------------
# 1. Database Configuration (Supabase PostgreSQL)
# ------------------------------------------------------------------------------
# DATABASE_URL: Transaction Pooler connection string (Port 6543) with pgbouncer=true
# Obtain from: Supabase Project Settings -> Database -> Connection string -> URI (Transaction Mode)
DATABASE_URL="postgresql://postgres.[YOUR_PROJECT_REF]:[YOUR_DB_PASSWORD]@aws-1-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT_URL: Direct Session connection string (Port 5432) needed for Prisma schema migrations
# Obtain from: Supabase Project Settings -> Database -> Connection string -> URI (Session Mode)
DIRECT_URL="postgresql://postgres.[YOUR_PROJECT_REF]:[YOUR_DB_PASSWORD]@aws-1-ap-northeast-1.pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------------------
# 2. Cryptographic & JWT Authentication Secrets
# ------------------------------------------------------------------------------
# Minimum 32 characters long. Generate using: `openssl rand -hex 32` or `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
JWT_ACCESS_SECRET="generate_random_32_characters_secret_key_access_finallinks"
JWT_REFRESH_SECRET="generate_random_32_characters_secret_key_refresh_finallinks"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN="7d"

# ------------------------------------------------------------------------------
# 3. CORS Configuration (Cross-Origin Resource Sharing)
# ------------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins (NO trailing slashes!).
# Include both production domains and Vercel preview domains if applicable.
CORS_ORIGIN="https://finallinks.com,https://admin.finallinks.com,https://your-frontend.vercel.app,https://your-admin.vercel.app"

# ------------------------------------------------------------------------------
# 4. Supabase Storage & Media SDK (For Logo & Cover Uploads)
# ------------------------------------------------------------------------------
# Obtain from: Supabase Project Settings -> API
SUPABASE_URL="https://[YOUR_PROJECT_REF].supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_STORAGE_BUCKET="finallinks-media"

# ------------------------------------------------------------------------------
# 5. Application URLs
# ------------------------------------------------------------------------------
# Used for generating invite links, password reset links, and verification emails
PUBLIC_WEB_URL="https://finallinks.com"
ADMIN_PANEL_URL="https://admin.finallinks.com"
OWNER_PANEL_URL="https://admin.finallinks.com"

# ------------------------------------------------------------------------------
# 6. Transactional Email / SMTP (Resend, SendGrid, Amazon SES, or Gmail)
# ------------------------------------------------------------------------------
SMTP_HOST="smtp.resend.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="resend"
SMTP_PASS="re_your_resend_api_key_here"
MAIL_FROM="FinalLinks <noreply@finallinks.com>"
ALLOW_TEMP_PASSWORD_EMAIL=true

# ------------------------------------------------------------------------------
# 7. Redis Cache & Rate Limiting (Optional - Upstash Redis or Render Redis)
# ------------------------------------------------------------------------------
# REDIS_HOST="your-redis-host.upstash.io"
# REDIS_PORT=6379
# REDIS_PASSWORD="your-redis-password"

# ------------------------------------------------------------------------------
# 8. Initial Super Admin Credentials (Used by prisma/seed.ts)
# ------------------------------------------------------------------------------
SUPER_ADMIN_EMAIL="admin@finallinks.com"
SUPER_ADMIN_PASSWORD="SuperAdminSecretPass123!"
