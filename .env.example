# FindFunLinks Root Monorepo Environment Variables Example
# Copy to .env or individual apps/.env as needed

# NestJS API
API_PORT=4000
NODE_ENV=development
ENABLE_SWAGGER=true
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:3002

# Supabase PostgreSQL (IPv4 Pooler & Direct)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-1-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-1-ap-northeast-1.pooler.supabase.com:5432/postgres"

# Supabase Storage & SDK
SUPABASE_URL="https://[PROJECT-REF].supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_STORAGE_BUCKET="findfunlinks-media"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Auth Secrets
JWT_ACCESS_SECRET=replace_with_super_secret_access_key_min_32_chars
JWT_REFRESH_SECRET=replace_with_super_secret_refresh_key_min_32_chars
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Mailpit (local) / SMTP (production)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM="FindFunLinks <noreply@findfunlinks.com>"
ALLOW_TEMP_PASSWORD_EMAIL=false

# Super Admin Seed
SUPER_ADMIN_EMAIL=admin@findfunlinks.com
SUPER_ADMIN_PASSWORD=SuperAdminSecretPass123!

# Frontend Public URLs
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WEB_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
NEXT_PUBLIC_OWNER_URL=http://localhost:3002
