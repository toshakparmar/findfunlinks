{
  "name": "finallinks-monorepo",
  "private": true,
  "packageManager": "pnpm@10.17.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "start:api": "node apps/api/dist/src/main.js",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\"",
    "audit:brand": "ts-node -P scripts/tsconfig.json scripts/brand-audit.ts",
    "audit:font": "ts-node -P scripts/tsconfig.json scripts/font-audit.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "prettier": "^3.4.2",
    "turbo": "^2.4.4",
    "typescript": "^5.7.3"
  }
}
